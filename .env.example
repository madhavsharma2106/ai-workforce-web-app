# Apollo.io API key, used by the Lead Sourcer to search for real leads.
# Get one at https://developer.apollo.io/
APOLLO_API_KEY=

# Supabase project credentials, used for auth and persistence.
# Find these in your Supabase project settings under API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service-role key. Server/job-only — never expose to the client.
# Used by background jobs (Inngest), which run with no user session and so
# bypass RLS entirely. Find it in Supabase project settings under API.
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic API key, used to power all employee reasoning/tool-use.
# Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Inngest keys, used to run background employee work (see docs/AGENTS.md).
# Find these in your Inngest dashboard under the app's settings.
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# Forces the Inngest client into dev mode locally, bypassing signature
# validation so `npx inngest-cli dev` can discover/invoke functions even if
# the keys above are set to real (production) values. Do not set this in any
# deployed environment.
INNGEST_DEV=1

# Microsoft Graph OAuth (Outlook), used by the Sales Representative to send
# approved outreach from the founder's own mailbox. These identify the app
# itself to Microsoft (set once, shared by every founder) — each founder's
# own mailbox connection is created separately when they connect from
# /settings. Register an app at https://portal.azure.com > App registrations
# ("Accounts in any organizational directory and personal Microsoft
# accounts"). Delegated permissions needed: Mail.Send, Mail.ReadWrite,
# offline_access, openid, profile, email, User.Read.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common
MICROSOFT_REDIRECT_URI=http://localhost:3000/api/integrations/outlook/callback

# Google OAuth (Gmail), used by the Sales Representative to send approved
# outreach from the founder's own mailbox — the Gmail equivalent of the
# Microsoft block above. These identify the app itself to Google (set once,
# shared by every founder); each founder's own mailbox connection is created
# separately when they connect from /settings. Create an OAuth client at
# https://console.cloud.google.com > APIs & Services > Credentials
# ("Web application" type), and enable the Gmail API for the project. Scope
# needed: https://www.googleapis.com/auth/gmail.modify. Note: while the
# OAuth consent screen is in "Testing" publishing status, only test users
# added on that screen can connect — switch to "In production" (which
# requires Google's verification for this sensitive scope) before onboarding
# founders who aren't added as test users.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/integrations/google/callback

# PostHog product analytics — pageviews, custom events, and user
# identification (client-side) plus server-side event capture (e.g. from API
# routes and Inngest jobs). Get a project key at https://app.posthog.com,
# under Project Settings > API keys. Optional — analytics/identify calls are
# silently skipped when unset, so the app behaves identically either way.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Optional: LangSmith tracing for chat sessions — traces every employee LLM
# turn (live chat and the LangGraph delegation graph alike), tagged with
# conversation/employee/run metadata (see docs/AGENTS.md). Purely a
# dev-debugging aid — the app behaves identically with these unset. Get an
# API key at https://smith.langchain.com/
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=ai-workforce
LANGSMITH_ENDPOINT=
